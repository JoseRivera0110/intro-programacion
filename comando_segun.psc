Algoritmo comando_segun
	
	Escribir "Ingresa un numero";
	Leer num;
	Segun num Hacer
		1:
			Escribir "El numero que suele ser mas usado";
		7:
			Escribir "Numero de la suerte"
		10:
			Escribir "Numero mas usado para hacer listas"
		De Otro Modo:
			Escribir "Prueba otro numero";
	Fin Segun
FinAlgoritmo
