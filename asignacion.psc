Algoritmo asignacion
//	Asignar no es mas que introducir un valor o dato a la variable, puede ser un valor fijo o una operacion.
	Escribir "Se van a sumar dos numeros";
	suma <- 1 + 1;
	Escribir "El resultado de la suma es: ", suma;
	Escribir "Ahora se van a sumar valores que digite el usuario";
	Escribir "Digita un numero";
	Leer num1;
	Escribir "Digita otro numero";
	Leer num2;
	suma = num1 + num2;
	Escribir "El resultado es el siguiente ", suma;
//	como se ve el valor de num1 y num2, se introdujo por el usuario.
FinAlgoritmo
